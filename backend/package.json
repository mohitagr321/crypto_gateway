{
  "name": "crypto-gateway-backend",
  "version": "1.0.0",
  "description": "USDT (BEP20) crypto payment gateway backend — API, blockchain listener, workers",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/index.js",
    "start:listener": "node dist/blockchain/listener.js",
    "start:listener:tron": "node dist/blockchain/tronListener.js",
    "start:all": "concurrently -n api,worker,bsc,eth,tron,btc -c green,cyan,magenta,blue,yellow,red \"npm:start\" \"npm:start:worker\" \"npm:start:listener\" \"npm:start:listener:eth\" \"npm:start:listener:tron\" \"npm:start:listener:btc\"",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "dev:listener": "tsx watch src/blockchain/listener.ts",
    "dev:listener:tron": "tsx watch src/blockchain/tronListener.ts",
    "dev:all": "concurrently -n api,worker,bsc,eth,tron,btc -c green,cyan,magenta,blue,yellow,red \"npm:dev\" \"npm:dev:worker\" \"npm:dev:listener\" \"npm:dev:listener:eth\" \"npm:dev:listener:tron\" \"npm:dev:listener:btc\"",
    "seed": "tsx src/seed.ts",
    "seed:prod": "node dist/seed.js",
    "typecheck": "tsc --noEmit",
    "start:listener:eth": "node dist/blockchain/ethListener.js",
    "dev:listener:eth": "tsx watch src/blockchain/ethListener.ts",
    "start:listener:btc": "node dist/blockchain/bitcoinListener.js",
    "dev:listener:btc": "tsx watch src/blockchain/bitcoinListener.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bitcoinjs-lib": "^6.1.7",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "speakeasy": "^2.0.0",
    "swagger-ui-express": "^5.0.1",
    "tronweb": "^6.4.0",
    "ulid": "^2.3.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/swagger-ui-express": "^4.1.6",
    "concurrently": "^9.0.1",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
