# Admin panel — copy to .env
# Base URL of the gateway API (must include /api/v1)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# White-label override, optional. Defaults to PayCrypo in src/lib/brand.ts.
# Keep in sync with the client panel and with BRAND_NAME in the repo-root .env.
VITE_BRAND_NAME=
