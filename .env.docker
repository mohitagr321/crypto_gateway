# Docker-only overrides, layered on top of .env by docker-compose.yml.
#
# Inside the compose network the datastores are reachable by SERVICE NAME on
# their real ports. The root .env points at localhost with the remapped host
# ports from docker-compose.override.yml, which is correct for processes run on
# the host (scripts/dev-up.sh) and wrong for containers — hence this file.
#
# NO SECRETS HERE. Those stay in .env, which compose loads first.

DATABASE_URL=postgres://gateway:gateway@postgres:5432/gateway
REDIS_URL=redis://redis:6379
