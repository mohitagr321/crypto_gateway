# Base URL of the gateway REST API (see repo-root .env.example).
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Block explorer used for txHash / address links.
VITE_BSCSCAN_URL=https://bscscan.com

# White-label overrides. Both are optional and default to PayCrypo /
# paycrypo.com in src/lib/brand.ts. Keep VITE_BRAND_NAME in sync with
# BRAND_NAME in the repo-root .env — a verification email from one name about a
# checkout branded with another reads exactly like a phish.
VITE_BRAND_NAME=
VITE_BRAND_DOMAIN=
