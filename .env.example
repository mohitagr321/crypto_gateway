# Crypto Gateway — environment contract.
#
#   cp .env.example .env   and fill in the values marked REQUIRED.
#
# Every variable here is validated by backend/src/config/env.ts at boot. A bad
# value fails the process immediately rather than at request time.
#
# NEVER commit the resulting .env: it holds the HD mnemonic and hot-wallet keys.

# ---- Core ----
NODE_ENV=production
PORT=4000
APP_BASE_URL=https://api.paycrypo.com
LOG_LEVEL=info

# ---- Datastores ---- (REQUIRED)
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379

# ---- Auth / crypto ---- (REQUIRED)
# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Exactly 64 hex chars (32 bytes): openssl rand -hex 32
# In production this must come from a KMS/Vault, not a static file.
MASTER_ENCRYPTION_KEY=

# ---- Blockchain: BSC / BEP20 ---- (REQUIRED)
BSC_HTTP_RPC=https://bsc-dataseed.binance.org
# Optional. Empty disables the live WS subscription; HTTP polling remains the
# source of truth, so this only affects how quickly a deposit is first seen.
BSC_WS_RPC=
BSC_CHAIN_ID=56
# USDT on BSC — 18 decimals, unlike USDT on Ethereum.
USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
USDT_DECIMALS=18
REQUIRED_CONFIRMATIONS=12
REORG_DEPTH=15
PAYMENT_EXPIRY_MINUTES=30

# ---- HD wallet ---- (REQUIRED)
# BIP-39 mnemonic that derives every deposit address. Deposit private keys are
# never stored — losing this loses access to all deposit funds. Back it up
# COLD/OFFLINE before taking a single real payment.
HD_WALLET_MNEMONIC=
HD_DERIVATION_PATH=m/44'/60'/0'/0

# ---- Central / gas wallets ---- (CENTRAL_WALLET_ADDRESS REQUIRED)
# Where swept deposits land and where payouts are signed from.
CENTRAL_WALLET_ADDRESS=
# The hot key controlling the address above. If unset, GAS_STATION_PRIVATE_KEY
# is used for both (single-hot-key setup). The address is DERIVED from whichever
# key is set, so sweeps and payouts can never target different wallets.
CENTRAL_WALLET_PRIVATE_KEY=
# Funds each deposit address with just enough BNB to pay for its sweep. Keep it
# topped up and monitored or sweeps stall.
GAS_STATION_PRIVATE_KEY=

# ---- Settlement ----
AUTO_PAYOUT_ENABLED=false
MIN_SWEEP_AMOUNT=1.0
GAS_TOPUP_BNB=0.0008

# ---- Optional networks ----
# Each is off by default and refuses to boot half-configured — see
# docs/deployment.md before switching one on.
ETH_ENABLED=false
ETH_HTTP_RPC=
ETH_CENTRAL_WALLET_PRIVATE_KEY=

TRON_ENABLED=false
TRON_FULL_HOST=https://api.trongrid.io
TRON_API_KEY=
TRON_CENTRAL_WALLET_PRIVATE_KEY=

BTC_ENABLED=false
BTC_NETWORK=mainnet
BTC_CENTRAL_WALLET_ADDRESS=

# ---- Accepted assets (per network) ----
# Comma-separated symbols, e.g. "USDC,BUSD". USDT is always accepted on an
# enabled network and does not need listing. Contract addresses live in
# backend/src/blockchain/assets.ts, never here.
ASSETS_BEP20=
ASSETS_TRC20=
ASSETS_ERC20=
# Second, deliberate gate: a native coin pays its sweep fee out of the balance
# being swept, which is the inverse of the token flow.
ACCEPT_NATIVE_COINS=false

# ---- Fiat pricing ----
FIAT_CURRENCIES=USD,INR,EUR
RATE_PROVIDER_URL=https://api.coingecko.com/api/v3/simple/price
COINGECKO_API_KEY=

# ---- Merchant self-registration ----
SIGNUP_ENABLED=true
# Where the MERCHANT panel is served — used only to build links in outbound
# email. APP_BASE_URL points at the API, which is a different host.
PUBLIC_PANEL_URL=https://paycrypo.com
SIGNUP_DEFAULT_COMMISSION_PERCENT=1

# ---- Outbound email: Brevo (preferred) ----
# Setting BREVO_API_KEY selects Brevo's transactional API and SMTP below is then
# ignored entirely. Get the key from Brevo → SMTP & API → API Keys (it starts
# `xkeysib-`). This is an API key, NOT the "SMTP key" on the same page.
BREVO_API_KEY=
# MUST be a sender or domain already verified in your Brevo account — Brevo
# rejects anything else on every send. Falls back to SMTP_FROM if empty.
BREVO_SENDER_EMAIL=no-reply@paycrypo.com
# From-line display name. Falls back to BRAND_NAME.
BREVO_SENDER_NAME=
# Optional but worth setting: the sender is no-reply and merchants do reply.
BREVO_REPLY_TO=
BREVO_TIMEOUT_MS=10000

# ---- Outbound email: SMTP (fallback) ----
# Leave BREVO_API_KEY and SMTP_HOST both empty in development: verification and
# reset emails are then LOGGED (link included) instead of sent. In production
# with SIGNUP_ENABLED=true one transport must be configured or the app refuses
# to boot. To use Brevo's SMTP relay instead of its API:
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<brevo login>
#   SMTP_PASSWORD=<brevo SMTP key>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Keep in sync with VITE_BRAND_NAME in the panels.
BRAND_NAME=PayCrypo
SUPPORT_EMAIL=support@paycrypo.com

# ---- Webhooks ----
WEBHOOK_MAX_RETRIES=8
WEBHOOK_TIMEOUT_MS=8000

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
SIGNUP_RATE_LIMIT_MAX=5
API_KEY_RATE_LIMIT_MAX=600

# ---- Database pool (read straight from process.env by src/db/pool.ts, so they
#      are NOT validated by config/env.ts; unset means today's behaviour) ----
# Connections per PROCESS. Every api/worker/listener replica opens its own pool,
# so the fleet total is DB_POOL_MAX x (number of processes) and must stay under
# the server's max_connections. Default 20.
# DB_POOL_MAX=20
# Server-side statement abort. Bounds LOCK WAITS as well as query time — a
# payout queued longer than this on the per-(client, network) advisory lock is
# aborted, rolls back cleanly before anything reaches the wire, and is retried
# by the settle tick. Set to 0 to disable while the index migrations are still
# unapplied. Default 15000.
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_READ_POOL_MAX=5
# DB_READ_STATEMENT_TIMEOUT_MS=5000

# ---- Auth ----
# Deployment aid ONLY. While true, a refresh token with no row in refresh_tokens
# is accepted, so sessions issued before migration 023 keep working across the
# deploy. It DEFEATS reuse detection for untracked tokens, so set it to false
# once JWT_REFRESH_EXPIRES_IN has elapsed since the deploy (7 days by default).
# Read straight from process.env by routes/auth.ts.
ALLOW_UNTRACKED_REFRESH_TOKENS=true
